# Environment variables for FH-Recorder

# Gemini API Key (for AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL
# Vercel Postgres: postgres://user:pass@host:5432/dbname?sslmode=require
# Neon: postgres://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgres://user:password@localhost:5432/hockalytics
